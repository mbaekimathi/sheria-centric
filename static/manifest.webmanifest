{
  "name": "SHERIA CENTRIC — Modern Advocates Firm",
  "short_name": "SHERIA CENTRIC",
  "description": "ERP for modern East African law firms: matters, documents, billing, calendar, compliance, and client portal in one secure workspace.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#1E1A4E",
  "theme_color": "#1E1A4E",
  "categories": ["productivity", "business", "finance"],
  "icons": [
    {
      "src": "/static/favicon-16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/static/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/static/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-maskable-192.png",
      "sizes": "192x192",
